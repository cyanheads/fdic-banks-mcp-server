{
  "manifest_version": "0.3",
  "name": "fdic-banks-mcp-server",
  "version": "0.1.0",
  "description": "US bank health and failures — FDIC BankFind Suite: FDIC-insured institution financials (Call Report metrics), bank failures since 1934, Summary of Deposits, and branch/structure data.",
  "author": { "name": "cyanheads" },
  "homepage": "https://github.com/cyanheads/fdic-banks-mcp-server#readme",
  "repository": { "type": "git", "url": "https://github.com/cyanheads/fdic-banks-mcp-server" },
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {}
}
